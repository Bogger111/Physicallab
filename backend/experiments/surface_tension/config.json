        },
        {
          "key": "density",
          "label": "盐水密度 ρ",
          "unit": "kg/m³",
          "default": 1035
        },
        {
          "key": "g",
          "label": "重力加速度",
          "unit": "m/s²",
          "default": 9.79338
        }
      ],
      "columns": [
        {
