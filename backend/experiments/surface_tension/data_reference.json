{
  "experiment_id": "surface-tension",
  "note": "示例仅用于量级与形态参考，不是标准答案",
  "data_reference": [
    {
      "name": "定标砝码质量与电压",
      "field": "calibration.rows.*.u_up",
      "example": [
        "0.5 g → 4.90 mV",
        "1.0 g → 9.79 mV",
        "2.5 g → 24.5 mV"
      ],
      "pattern": [
        "电压与砝码重力成正比（斜率约 1000 mV/N）",
        "8 点等间距加载，R² 应接近 1"
      ]
    },
    {
      "name": "拉脱法：拉脱前后电压 U1 / U2",
      "field": "pull_off.rows.*.u1",
      "example": [
        "U1 = 15.8 mV",
        "U2 = 0.2 mV",
        "ΔU = 15.6 mV"
      ],
      "pattern": [
        "σ = |U1−U2| / [π(D1+D2)·K] ≈ 0.073 N/m",
        "室温纯水标准值 0.07275 N/m，相对误差通常 <5%"
      ]
    },
    {
      "name": "毛细管法：液柱高度与内径",
      "field": "capillary.rows.*.y1",
      "example": [
        "y1 = 45.0 mm",
        "y2 = 7.9 mm",
        "h = 37.1 mm",
        "内径 d = 0.8 mm"
      ],
      "pattern": [
        "σ = ρgd(h + d/6)/4 ≈ 0.0728 N/m",
        "h 必须是毫米量级（几十 mm），不是几 mm"
      ]
    },
    {
      "name": "盐水组（选做）",
      "field": "salt_pull_off.rows.*.u1",
      "example": [
        "5% NaCl 拉脱法：ΔU ≈ 15.9 mV",
        "5% NaCl 毛细管法：h ≈ 36.6 mm",
        "σ ≈ 0.0745 N/m（略高于纯水）"
      ],
      "pattern": [
        "盐水表面张力略高于纯水（约 0.074 N/m）",
        "同一浓度下两法结果应彼此接近"
      ]
    }
  ]
}
