      {"id":"peaks","name":"峰值位置与逐差","required":true,"description":"以峰间距计算第一激发电位","rowCount":6,"columns":[{"key":"peak_voltage","label":"峰值电压 Up","unit":"V"}],"results":[{"key":"v0","label":"第一激发电位 V0","unit":"V"},{"key":"relative_error","label":"相对误差","unit":"%"},{"key":"spacing_std","label":"峰间距标准差","unit":"V"}]},
      {"id":"parameter_curve","name":"改变工作参数的对比曲线（选做）","required":false,"description":"自行改变炉温、拒斥电压或灯丝电压，记录对比曲线","rowCount":30,"params":[{"key":"temperature","label":"炉温","unit":"°C","default":220},{"key":"vf","label":"VF","unit":"V","default":0.9},{"key":"vg1k","label":"VG1K","unit":"V","default":1.5},{"key":"vg2p","label":"VG2P","unit":"V","default":1.3}],"columns":[{"key":"voltage","label":"VG2K","unit":"V"},{"key":"current_reference","label":"IP 基准","unit":"nA"},{"key":"current_variant","label":"IP 改参后","unit":"nA"}],"results":[{"key":"data_points","label":"有效对比点数","unit":""},{"key":"max_difference","label":"最大电流差","unit":"nA"}]},
