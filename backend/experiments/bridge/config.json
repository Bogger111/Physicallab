{
  "id": "bridge",
  "name": "交直流电桥的原理及应用",
  "category": "电磁学",
  "description": "用平衡与非平衡电桥测电阻和温度特性，并测量交流电容、电感参数。",
  "processingTime": "~45秒",
  "measurements": [
    "平衡电阻 Rn",
    "温度与非平衡输出 U0",
    "交流电桥平衡参数"
  ],
  "methods": [
    {
      "id": "balanced",
      "name": "平衡直流电桥",
      "required": true,
      "description": "测 Cu50 室温电阻，与室温理论值 50(1+0.004280t) 比较算相对误差",
      "rowCount": 3,
      "params": [
        {
          "key": "ra",
          "label": "Ra",
          "unit": "Ω",
          "default": 1000
        },
        {
          "key": "rb",
          "label": "Rb",
          "unit": "Ω",
          "default": 5000
        },
        {
          "key": "us",
          "label": "电源电压 Us",
          "unit": "V",
          "default": 3.0
        },
        {
          "key": "t_room",
          "label": "室温 t",
          "unit": "°C",
          "default": 20.0
        }
      ],
      "columns": [
        {
          "key": "rn",
          "label": "平衡电阻 Rn",
          "unit": "Ω"
        }
      ],
      "results": [
        {
          "key": "rx_mean",
          "label": "Rx 均值",
          "unit": "Ω"
        },
        {
          "key": "theory",
          "label": "室温理论值",
          "unit": "Ω"
        },
        {
          "key": "relative_error",
          "label": "相对误差",
          "unit": "%"
        }
      ]
    },
    {
      "id": "cu50",
      "name": "卧式电桥测 Cu50",
      "required": true,
      "description": "卧式电桥严格反解 ΔRx=4Rn·U0/(Us-2U0) 后拟合 R-t 求 R0 与 α",
      "rowCount": 10,
      "monotonic": {
        "field": "temperature",
        "direction": "increasing"
      },
      "params": [
        {
          "key": "us",
          "label": "电源 Us",
          "unit": "V",
          "default": 3
        },
        {
          "key": "rn",
          "label": "预平衡 Rn",
          "unit": "Ω",
          "default": 54.3
        }
      ],
      "columns": [
        {
          "key": "temperature",
          "label": "温度 t",
          "unit": "°C"
        },
        {
          "key": "u0",
          "label": "输出 U0",
          "unit": "mV"
        }
      ],
      "results": [
        {
          "key": "r0",
          "label": "拟合 R0",
          "unit": "Ω"
        },
        {
          "key": "r0_error",
          "label": "R0 相对误差",
          "unit": "%"
        },
        {
          "key": "alpha",
          "label": "温度系数 α",
          "unit": "1/°C"
        },
        {
          "key": "r_squared",
          "label": "R²",
          "unit": ""
        },
        {
          "key": "alpha_error",
          "label": "α 相对误差",
          "unit": "%"
        }
      ]
    },
    {
      "id": "capacitor",
      "name": "交流电桥测电容",
      "required": true,
      "description": "维恩电桥平衡式反算 Cx、损耗电阻 rC 与 tanδ",
      "rowCount": 3,
      "params": [
        {
          "key": "ra",
          "label": "Ra",
          "unit": "Ω",
          "default": 100
        },
        {
          "key": "rb",
          "label": "Rb",
          "unit": "Ω",
          "default": 120
        },
        {
          "key": "f",
          "label": "频率 f",
          "unit": "Hz",
          "default": 1000
        }
      ],
      "columns": [
        {
          "key": "cn",
          "label": "Cn",
          "unit": "μF"
        },
        {
          "key": "rn",
          "label": "Rn",
          "unit": "Ω"
        }
      ],
      "results": [
        {
          "key": "cx",
          "label": "Cx 均值",
          "unit": "μF"
        },
        {
          "key": "rc",
          "label": "rC 均值",
          "unit": "Ω"
        },
        {
          "key": "tan_delta",
          "label": "tanδ 均值",
          "unit": ""
        }
      ]
    },
    {
      "id": "inductor",
      "name": "交流电桥测电感",
      "required": true,
      "description": "麦克斯韦电桥平衡式反算 Lx、线圈电阻 rL 与品质因数 Q",
      "rowCount": 3,
      "params": [
        {
          "key": "ra",
          "label": "Ra",
          "unit": "Ω",
          "default": 100
        },
        {
          "key": "rb",
          "label": "Rb",
          "unit": "Ω",
          "default": 100
        },
        {
          "key": "f",
          "label": "频率 f",
          "unit": "Hz",
          "default": 1000
        }
      ],
      "columns": [
        {
          "key": "cn",
          "label": "Cn",
          "unit": "μF"
        },
        {
          "key": "rn",
          "label": "Rn",
          "unit": "Ω"
        }
      ],
      "results": [
        {
          "key": "lx",
          "label": "Lx 均值",
          "unit": "mH"
        },
        {
          "key": "rl",
          "label": "rL 均值",
          "unit": "Ω"
        },
        {
          "key": "q",
          "label": "Q 均值",
          "unit": ""
        }
      ]
    },
    {
      "id": "thermistor",
      "name": "热敏电阻（选做）",
      "required": false,
      "description": "立式电桥反解阻值，做 R-t 与 lnR-1/T 曲线并拟合材料常数 B",
      "rowCount": 10,
      "monotonic": {
        "field": "temperature",
        "direction": "increasing"
      },
      "params": [
        {
          "key": "us",
          "label": "电源 Us",
          "unit": "V",
          "default": 3
        },
        {
          "key": "r_prime",
          "label": "桥臂 Ra=Rb",
          "unit": "Ω",
          "default": 100
        },
        {
          "key": "rn",
          "label": "预平衡 Rn",
          "unit": "Ω",
          "default": 3250
        }
      ],
      "columns": [
        {
          "key": "temperature",
          "label": "温度 t",
          "unit": "°C"
        },
        {
          "key": "u0",
          "label": "输出 U0",
          "unit": "mV"
        }
      ],
      "results": [
        {
          "key": "b_constant",
          "label": "材料常数 B",
          "unit": "K"
        },
        {
          "key": "r25",
          "label": "R25",
          "unit": "Ω"
        },
        {
          "key": "r_squared",
          "label": "R²",
          "unit": ""
        }
      ]
    }
  ],
  "discussion": {
    "errors": "检流计零漂、桥臂标称误差与接触电阻；升温过快导致的热滞后（后段 U0 明显偏小）；交流电桥幅平衡与相平衡耦合，Cn 与 Rn 需交替逼近。",
    "suggestions": "温度稳定后读数；卧式电桥的 Rn 填预调平衡时的实测读数（它同时是反解式里的 R）；交流电桥交替调节 Cn 与 Rn，逐步提高检流计灵敏度直到示数趋近于零。",
    "extensions": "比较卧式电桥严格反解与线性近似的偏差；用同一组数据讨论剔除热滞后点后 α 的变化；分析热敏电阻自热效应及其对材料常数 B 的影响。"
  }
}
