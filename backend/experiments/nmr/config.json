          11.8
        ]
      },
      "results": [
        {
          "key": "gamma",
          "label": "γ/2π",
          "unit": "MHz/T"
        },
        {
          "key": "g_factor",
          "label": "g 因子",
          "unit": ""
        },
        {
          "key": "relative_error",
          "label": "相对误差",
          "unit": "%"
        },
        {
          "key": "r_squared",
          "label": "R^2",
          "unit": ""
        }
      ]
    },
    {
      "id": "pure_water",
      "name": "纯水样品 g 因子（选做）",
      "required": false,
      "description": "按 1H 方法自行设计并记录纯水样品数据",
      "rowCount": 10,
      "columns": [
        {
